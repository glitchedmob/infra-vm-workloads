export AWS_DEFAULT_PROFILE="your-aws-profile-name"

# Proxmox provider auth
export TF_VAR_proxmox_endpoint="https://x86-node-01:8006/"

# Cloudflare Tunnel provider auth
export TF_VAR_cloudflare_account_id="your-cloudflare-account-id"

ssm_values="$(
  aws --profile "$AWS_DEFAULT_PROFILE" ssm get-parameters \
    --names \
      "/infra/lz/infra-vm-workloads/TF_VAR_proxmox_api_token" \
      "/infra/lz/infra-vm-workloads/TF_VAR_b2_application_key_id" \
      "/infra/lz/infra-vm-workloads/TF_VAR_b2_application_key" \
      "/infra/lz/infra-vm-workloads/TF_VAR_cloudflare_api_token" \
    --with-decryption --output json --no-cli-pager |
    jq '.Parameters | map({key: (.Name | split("/") | last), value: .Value}) | from_entries'
)"

export TF_VAR_proxmox_api_token="$(jq -r '.TF_VAR_proxmox_api_token' <<< "$ssm_values")"
export TF_VAR_b2_application_key_id="$(jq -r '.TF_VAR_b2_application_key_id' <<< "$ssm_values")"
export TF_VAR_b2_application_key="$(jq -r '.TF_VAR_b2_application_key' <<< "$ssm_values")"
export TF_VAR_cloudflare_api_token="$(jq -r '.TF_VAR_cloudflare_api_token' <<< "$ssm_values")"

unset ssm_values
